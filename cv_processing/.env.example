# CV Processing Service Configuration
# Copy this file to .env and update with your values

# Service Configuration
SERVICE_NAME=CV Processing Service
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8002
DEBUG=False

# PostgreSQL Database Configuration
POSTGRES_USER=nlp_admin
POSTGRES_PASSWORD=changeme123
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nlp_platform

# Groq API Configuration (for CV Processing)
# Get your API key from: https://console.groq.com
GROQ_CV_API_KEY=gsk_your_api_key_here
GROQ_CV_MODEL=llama-3.3-70b-versatile

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# Celery Configuration
# Automatically constructed from Redis credentials
# CELERY_BROKER_URL=redis://:redis123@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/2

# Celery Task Configuration
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# CV Processing Configuration
MAX_FILE_SIZE_MB=20
TEMP_FILE_DIR=/tmp

# Model Configuration
CV_EXTRACTION_MODEL=groq
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
