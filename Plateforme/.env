# .env - Version corrigée et nettoyée

# Database (Local PostgreSQL in Docker)
DATABASE_URL=postgresql://nlp_admin:1008@localhost:5432/nlp_platform

# Django
DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.105,django,nginx

# Email (optionnel)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Elasticsearch (optionnel)
ELASTIC_URL=http://localhost:9200
# FastAPI Chatbot Integration
FASTAPI_URL=http://localhost:8001
FASTAPI_API_KEY=
CHATBOT_TIMEOUT=180
