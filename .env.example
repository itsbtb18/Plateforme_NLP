# ============================================================
# Plateforme NLP — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ============================================================

# ---- Shared Infrastructure ----
POSTGRES_DB=nlp_platform
POSTGRES_USER=nlp_admin
POSTGRES_PASSWORD=changeme123
REDIS_PASSWORD=redis123

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django

# ---- Django → FastAPI bridge ----
FASTAPI_URL=http://fastapi:8000
FASTAPI_API_KEY=

# ---- Django Chatbot Settings ----
CHATBOT_MAX_HISTORY=20
CHATBOT_MAX_TOKENS=8192
CHATBOT_TIMEOUT=180
CHATBOT_MAX_FILE_SIZE=20971520

# ---- Gmail SMTP ----
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ---- Groq API (LLM — Chatbot) ----
GROQ_API_KEY=gsk_your_chatbot_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Groq API (LLM — Scraping Validation) ----
GROQ_SCRAPING_API_KEY=gsk_your_scraping_api_key_here
GROQ_SCRAPING_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.7

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# ---- Qdrant (vector store) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# ---- Redis / Celery ----
REDIS_URL=redis://:redis123@redis:6379/0
CELERY_BROKER_URL=redis://:redis123@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/2

# ---- FastAPI App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Vector Search ----
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35

# ---- Rate Limiting ----
MAX_REQUESTS_PER_MINUTE=30

# ---- Document Processing ----
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOC=500

# ---- Chat Memory ----
MAX_HISTORY_MESSAGES=20
HISTORY_SUMMARY_THRESHOLD=12
TOKEN_BUDGET_HISTORY=1500
TOKEN_BUDGET_SUMMARY=500


# ============================================================
# SCRAPING MODULE — Centralised Configuration
# ============================================================
# All values below have sensible defaults in
#   scraping/scraping_settings.py
# You only need to set overrides here.
# ============================================================

# ── Timeouts (seconds unless noted) ──────────────────────────
# SCRAPING_CONNECT_TIMEOUT=3.0          # TCP connect timeout
# SCRAPING_READ_TIMEOUT=7.0             # HTTP body read timeout
# SCRAPING_TOTAL_TIMEOUT=10.0           # Overall per-request timeout
# SCRAPING_LLM_TIMEOUT=30.0             # Groq / LLM API call timeout
# SCRAPING_HEAD_TIMEOUT=10.0            # HEAD preflight request timeout
# SCRAPING_PLAYWRIGHT_TIMEOUT_MS=30000  # Playwright page-load timeout (ms)
# SCRAPING_WAYBACK_MAX_AGE_DAYS=90      # Max age for Wayback snapshots (days)
# SCRAPING_SOURCE_TEST_TTL_SECONDS=1800 # Source reachability cache TTL (s)
# SCRAPING_GLOBAL_FALLBACK_PROXY=http://user:pass@host:port # Global proxy fallback

# ── Retry Policy ─────────────────────────────────────────────
# SCRAPING_MAX_RETRIES=3                # Max HTTP request retries
# SCRAPING_RETRY_BACKOFF_BASE=30        # Base delay for exp. backoff (s)
# SCRAPING_RETRY_BACKOFF_CAP=180        # Max delay for backoff (s)
# SCRAPING_RETRY_AFTER_BUFFER=2         # Extra seconds on Retry-After

# ── Rate Limits ──────────────────────────────────────────────
# SCRAPING_MAX_CONCURRENT_DOWNLOADS=4   # Parallel media downloads
# SCRAPING_METRICS_LAG_INTERVAL=60      # Min seconds between lag updates

# ── Deduplication Policy ─────────────────────────────────────
# SCRAPING_JACCARD_THRESHOLD=0.85       # Jaccard threshold  (loose)
# SCRAPING_STRICT_JACCARD=0.90          # Jaccard threshold  (strict)
# SCRAPING_SEMANTIC_FALLBACK=0.88       # Cosine similarity  (semantic)
# SCRAPING_DEDUP_WINDOW=500             # Recent items to compare against
# SCRAPING_DEDUP_DATE_OVERLAP_DAYS=3    # Date gap before items are distinct

# ── Freshness Windows (days) ─────────────────────────────────
# SCRAPING_FRESHNESS_NEWS_DAYS=30
# SCRAPING_FRESHNESS_EVENTS_DAYS=730
# SCRAPING_FRESHNESS_COURSES_DAYS=730
# SCRAPING_FRESHNESS_TOOLS_DAYS=365
# SCRAPING_FRESHNESS_INST_DAYS=365

# ── Enrichment Policy ────────────────────────────────────────
# SCRAPING_ENRICH_MAX_TOPICS=5          # Topics extracted per item
# SCRAPING_ENRICH_MAX_KEYWORDS=8        # Keywords extracted per item
# SCRAPING_SPACY_MODEL=en_core_web_sm   # Default spaCy NER model
# SCRAPING_SPACY_MODEL_AR=xx_ent_wiki_sm # Arabic/multilingual spaCy NER model
# SCRAPING_SPACY_MAX_CHARS=50000        # Max chars sent to spaCy per item
# SCRAPING_LLM_CONFIDENCE=0.70          # Min LLM confidence to accept
# SCRAPING_LLM_MAX_TOKENS=50            # Max output tokens (short calls)

# ── Storage Limits ───────────────────────────────────────────
# SCRAPING_MAX_DOCUMENT_MB=50           # Max document download size (MB)
# SCRAPING_MAX_IMAGE_MB=10              # Max image download size (MB)
# SCRAPING_DOWNLOAD_CHUNK_BYTES=8192    # Stream chunk size (bytes)
# SCRAPING_TRUNCATE_SUMMARY_LEN=200     # Truncated summary max length

# ── Scraping Limits ──────────────────────────────────────────
# SCRAPING_RSS_MAX_ITEMS=50             # Max items per RSS feed
# SCRAPING_RSS_DESC_MIN_LEN=200         # Min RSS desc before full-page fetch
# SCRAPING_RSS_MAX_CHARS=3000           # Max chars from RSS full-content
# SCRAPING_LISTING_MAX_CONTAINERS=180   # Max listing containers per page
# SCRAPING_MAX_PAGES_DEFAULT=3          # Default listing pages per source/path
# SCRAPING_MAX_PAGES_HARD_LIMIT=10      # Absolute cap for listing page loops
# SCRAPING_ARXIV_PAGE_SIZE=20           # arXiv API page size
# SCRAPING_ARXIV_MAX_TOTAL=100          # Max arXiv records per run
# SCRAPING_S2_MAX_TOTAL=100             # Max Semantic Scholar records per query
# SCRAPING_DISCOVERY_SAMPLE_COUNT=5     # Sample pages for selector discovery
# SCRAPING_PLAYWRIGHT_THRESHOLD=200     # Min content length for Playwright

# ── Circuit Breaker ──────────────────────────────────────────
# SCRAPING_CIRCUIT_THRESHOLD=25.0       # Health score to trip breaker
# SCRAPING_CIRCUIT_TRIP_COUNT=5         # Consecutive failures to trip
# SCRAPING_CIRCUIT_COOLDOWN=300         # Seconds before half-open probe
# SCRAPING_FAILURE_PENALTY=15.0         # Points deducted per failure
# SCRAPING_SUCCESS_RECOVERY=10.0        # Points recovered per success

# ── Persistence ──────────────────────────────────────────────
# SCRAPING_DEAD_LETTER_DIR=logs/scraping_dead_letters
# SCRAPING_CHECKPOINT_DIR=logs/scraping_checkpoints
# SCRAPING_CHECKPOINT_TTL=259200        # Checkpoint cache TTL (3 days)
# SCRAPING_CHECKPOINT_TOKEN_LEN=16      # Checkpoint filename hash length

# ── Robots Policy ────────────────────────────────────────────
# SCRAPING_ROBOTS_CACHE_TTL=3600        # robots.txt cache TTL (s)
# SCRAPING_ROBOTS_FAIL_OPEN=true        # Fail open on unreachable robots.txt
# SCRAPING_RESPECT_ROBOTS=true          # Set false to skip robots.txt checks

# ── Downloads Toggle ─────────────────────────────────────────
# SCRAPING_DOWNLOAD_ENABLED=true        # Set false to disable media downloads
# SCRAPING_ALLOWED_DOMAINS=             # Comma-sep whitelist (empty = allow all)

# ── LLM Model Override ───────────────────────────────────────
# SCRAPING_LLM_MODEL=llama3-8b-8192    # Override default scraping LLM model

# ── View Rate Limits ─────────────────────────────────────────
# SCRAPING_VIEW_RATE_DEFAULT=60         # Default view endpoint rate limit
# SCRAPING_VIEW_RATE_TRIGGER=5          # Action endpoint rate limit
# SCRAPING_VIEW_RATE_STANDARD=30        # Standard read endpoint rate limit
# SCRAPING_VIEW_RATE_METRICS=10         # Metrics endpoint rate limit
# SCRAPING_VIEW_RECENT_RUNS=10          # Recent runs shown in dashboard

# ── Dedup Confidence ─────────────────────────────────────────
# SCRAPING_FALLBACK_DEDUP_CONF=85.0     # Default dedup match confidence %
