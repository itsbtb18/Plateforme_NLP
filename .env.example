# ============================================================
# Plateforme NLP — Combined Environment Configuration
# ============================================================
# Shared by: docker-compose, Django, FastAPI, Celery
# NEVER commit secrets (API keys, passwords) to version control.
# Copy this file to .env and fill in with your actual values.
# ============================================================

# ---- Shared Infrastructure ----
POSTGRES_DB=nlp_platform
POSTGRES_USER=nlp_admin
POSTGRES_PASSWORD=changeme_secure_password_here
REDIS_PASSWORD=changeme_redis_password_here

# ---- Django ----
DJANGO_SECRET_KEY=your-django-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com

# ---- Django → FastAPI bridge ----
FASTAPI_URL=http://fastapi:8000
FASTAPI_API_KEY=your-fastapi-api-key-here

# ---- Django Chatbot Settings ----
CHATBOT_MAX_HISTORY=20
CHATBOT_MAX_TOKENS=8192
CHATBOT_TIMEOUT=180
CHATBOT_MAX_FILE_SIZE=20971520

# ---- Gmail SMTP ----
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ---- Groq API (LLM — Chatbot) ----
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Groq API (LLM — Internal Logic: Classifier, Rewriter, Faithfulness) ----
# Leave blank to use the same key/model as above, or specify separate ones.
GROQ_INTERNAL_API_KEY=gsk_your_internal_groq_api_key_here
GROQ_INTERNAL_MODEL=llama-3.1-8b-instant

# ---- Groq API (LLM — Scraping Validation) ----
GROQ_SCRAPING_API_KEY=gsk_your_scraping_groq_api_key_here
GROQ_SCRAPING_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.7

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ---- Qdrant (vector store) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-jwt-token-here
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# ---- Redis / Celery ----
REDIS_URL=redis://:redis123@redis:6379/0
CELERY_BROKER_URL=redis://:redis123@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/2

# ---- FastAPI App ----
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---- Vector Search ----
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35

# ---- Rate Limiting ----
MAX_REQUESTS_PER_MINUTE=30

# ---- Document Processing ----
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOC=500

# ---- Chat Memory ----
MAX_HISTORY_MESSAGES=20
HISTORY_SUMMARY_THRESHOLD=12
TOKEN_BUDGET_HISTORY=1500
TOKEN_BUDGET_SUMMARY=500

# ---- Web Search (Exa — RAG fallback retrieval) ----
EXA_API_KEY=your-exa-api-key-here
EXA_ENABLED=true
EXA_MAX_CALLS_PER_SESSION=10
EXA_MAX_CALLS_PER_HOUR=30
EXA_CACHE_TTL_HOURS=24

# ---- Web Search (Tavily — User-triggered web mode) ----
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_ENABLED=true
