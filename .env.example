# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,django

# Database
POSTGRES_DB=nlp_platform
POSTGRES_USER=nlp_admin
POSTGRES_PASSWORD=changeme123
DATABASE_URL=postgresql://nlp_admin:changeme123@db:5432/nlp_platform

# Redis
REDIS_PASSWORD=redis123

# Email Configuration (Gmail SMTP)
# 1. Enable 2FA on your Gmail account: https://myaccount.google.com/
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (without spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Groq API (for FastAPI chatbot)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Environment
ENVIRONMENT=production

# Django Secret (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY=your-django-secret-key-here
