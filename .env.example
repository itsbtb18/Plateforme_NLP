# =============================================
# Core Django settings
# =============================================
# Required: cryptographically secure Django secret key.
DJANGO_SECRET_KEY=change-me-in-production

# Required: set to False in production.
DJANGO_DEBUG=False

# Required: comma-separated hostnames allowed by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# =============================================
# Database / cache / broker
# =============================================
# Required: full Django database URL.
DATABASE_URL=postgresql://nlp_admin:changeme123@db:5432/nlp_platform

# Required: Redis URL for cache/channels.
REDIS_URL=redis://:redis123@redis:6379/0

# =============================================
# Scraping and AI keys
# =============================================
# Required for FastAPI chatbot and LLM integrations.
GROQ_API_KEY=

# Optional (Django scraping validator key); keep if scraping enrichment is enabled.
GROQ_SCRAPING_API_KEY=

# Optional: improves tools scraper coverage via GitHub metadata.
GITHUB_TOKEN=

# Optional: improves courses scraper YouTube ingestion.
YOUTUBE_API_KEY=

# =============================================
# Scraping runtime controls
# =============================================
# Required: enable/disable media downloading in scraping.
SCRAPING_DOWNLOAD_ENABLED=true

# Required: max concurrent media downloads per worker.
SCRAPING_MAX_CONCURRENT_DOWNLOADS=4

# Required for Prometheus scraping endpoint authorization.
METRICS_TOKEN=replace-with-strong-token

# =============================================
# Monitoring
# =============================================
# Required for Grafana admin login.
GRAFANA_PASSWORD=change-me

# =============================================
# Optional integrations
# =============================================
# Optional: external Elasticsearch endpoint override.
ELASTICSEARCH_URL=http://elasticsearch:9200

# =============================================
# Common compose variables (recommended)
# =============================================
POSTGRES_DB=nlp_platform
POSTGRES_USER=nlp_admin
POSTGRES_PASSWORD=changeme123
REDIS_PASSWORD=redis123
