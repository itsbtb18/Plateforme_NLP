' ==============================
' ADMIN PANEL / AUDIT
' ==============================
class Stats {
  +date: DateField
  +users_count: IntegerField
  +publications_count: IntegerField
  +corpora_count: IntegerField
  +tools_count: IntegerField
  +projects_count: IntegerField
  +visits_count: IntegerField
}

class UserStatusHistory {
  +id: Integer
  +user_id: UUID
  +old_status: CharField
  +new_status: CharField
  +changed_by_id: UUID
  +change_date: DateTimeField
  +reason: TextField
  +log_change(...): UserStatusHistory
}

class ContactMessage {
  +id: Integer
  +user_id: UUID
  +name: CharField
  +email: EmailField
  +subject: CharField
  +message: TextField
  +status: CharField
