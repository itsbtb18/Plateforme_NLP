}

class ChatRoom {
  +id: UUIDField
  +topic_id: UUID
  +name: CharField
  +creator_id: UUID
  +created_at: DateTimeField
}

class ForumMessage {
  +id: UUIDField
  +chatroom_id: UUID
  +user_id: UUID
  +parent_id: UUID
  +content: TextField
  +timestamp: DateTimeField
}

class BannedUser {
  +id: UUIDField
  +chatroom_id: UUID
  +user_id: UUID
  +banned_by_id: UUID
  +banned_at: DateTimeField
  +reason: TextField
}

Topic "1" -- "0..*" ChatRoom
ChatRoom "1" -- "0..*" ForumMessage
ChatRoom "1" -- "0..*" BannedUser
User "1" -- "0..*" Topic : creator
User "1" -- "0..*" ForumMessage
Admin "1" --> "0..*" Topic : approve/reject
ForumSection "1" o-- "0..*" Topic

