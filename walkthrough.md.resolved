def source_rules(language: str, source_type: str) -> str:
    """Return source-specific behavioural rules appended to the system prompt."""
    if source_type == "legal":
        rules = {
            "ar": (
                "\n\nتعليمات خاصة بالأسئلة القانونية (وضع القاضي/المستشار):\n"
